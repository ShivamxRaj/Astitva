    {
      "parameters": {
        "sendTo": "={{ $(\"Get Full Message\").first().json.to.text }}",
        "subject": "=Weekend Email Summary - {{ $now.toFormat(\"MMMM d, yyyy\") }}",
        "message": "=\u003Ch2\u003EYour Weekend Email Summary\u003C/h2\u003E\n\u003Cp\u003EHere is an organized summary of your weekend emails:\u003C/p\u003E\n\u003Cpre style=\"background-color: #f5f5f5; padding: 15px; border-radius: 5px; white-space: pre-wrap;\"\u003E{{ $json.output }}\u003C/pre\u003E\n\u003Chr\u003E\n\u003Cp style=\"color: #666; font-size: 12px;\"\u003EThis summary was automatically generated by your n8n workflow.\u003C/p\u003E",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "1e37d69d-99a1-4525-9f25-7c3fa52981b2",
      "name": "Send Summary Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1488, 608],
      "webhookId": "63897377-f625-48bb-ae5d-7e1b20fc9fe8",
      "credentials": {
        "gmailOAuth2": {
          "id": "xKoPhfE9aIF1DD2R",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json; const subject = data.subject || \"(No Subject)\"; const from = data.from?.text || data.from?.html || \"Unknown Sender\"; const dateStr = data.date || \"Unknown Date\"; let date = dateStr; try { date = new Date(dateStr).toLocaleString(); } catch (e) { date = dateStr; } let body = data.text || data.textAsHtml || \"\"; if (!body && data.html) { body = data.html.replace(/\u003C[^\u003E]*\u003E/g, \" \").replace(/\\s+/g, \" \").trim(); } body = body.replace(/\\s+/g, \" \").trim().substring(0, 2000); return { subject, from, date, body: body || \"(No content)\" };"
      },
      "id": "2dd4467e-78ce-417b-9285-b7346d4f141c",
